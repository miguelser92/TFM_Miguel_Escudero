# === Datos (en disco externo E:, nunca en el repo) ===
*.dat
*.tsv

# === Artefactos de Python ===
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# === Salidas de entrenamiento / evaluación (reproducibles) ===
runs/
*.pth

# === Weights & Biases (caché local de runs) ===
wandb/

# === PDFs / PNG / datos de informes (salidas reproducibles, no código) ===
reports/*.pdf
reports/*.png
reports/*.json
reports/*.npz
figs_arquitecturas/

# === Tabla de métricas (binario, se regenera desde los JSON de runs/) ===
Metricas_runs_TFM*.xlsx

# === Código antiguo (superseded) ===
Old Code/

# === Sistema ===
.DS_Store
Thumbs.db
desktop.ini

# === Tandas nocturnas: scripts versionados, logs no ===
tandas/logs/
*.log

# === LaTeX: se versiona el .tex, no lo que produce al compilar ===
